# PFLICHT: Hauptschlüssel (mindestens 32 Zeichen). Erzeugen mit: openssl rand -base64 48
# Daraus werden die Schlüssel für Verschlüsselung und CSRF-Schutz abgeleitet.
# WICHTIG: Sichere ihn getrennt von den Daten. Geht er verloren, sind die 2FA-Geheimnisse
# nicht mehr lesbar, und alle müssen die Zwei-Faktor-Anmeldung neu einrichten.
# Alternativ als Docker Secret: SECRET_KEY_FILE=/run/secrets/gk_secret_key
SECRET_KEY=

# Öffentliche Adresse hinter dem Reverse Proxy (für Links in Mails und Cookies).
# Mit https:// werden Cookies automatisch als "Secure" gesetzt.
BASE_URL=https://gutscheine.example.de

# Von welchen Adressen die App den Proxy-Headern (X-Forwarded-For) glaubt. Davon hängt ab, dass die
# Begrenzung von Anmeldeversuchen die echte Adresse eines Besuchers sieht und nicht die des Proxys.
#
# Für den Container kommt jede Anfrage über Docker vom Gateway-Netz (z. B. 172.18.0.1), auch wenn dein
# Proxy auf demselben Host läuft und 127.0.0.1:8000 anspricht. Der Standard unten deckt die üblichen
# Docker-Netze ab. Trage bei Bedarf das genaue Netz oder die Adresse deines Proxys ein (kommagetrennt,
# siehe docs/reverse-proxy.md). NICHT "*" verwenden: Dann übernimmt die App den ersten Eintrag der
# Kette, und den kann ein Besucher selbst setzen (spätestens, wenn der Proxy Header nur anhängt).
FORWARDED_ALLOW_IPS=172.16.0.0/12

# Optional: Feste Image-Version statt "latest", z. B. ghcr.io/teitech/gutscheinkontor:1.0.0
# GK_IMAGE=

# E-Mail-Versand (SMTP) für Passwort-Reset, Einladungen und Erinnerungen.
# Ohne SMTP_HOST und SMTP_FROM bleibt der Versand aus. Ein Reset-Link lässt sich dann auf der
# Kommandozeile erzeugen:  docker compose exec gutscheinkontor python -m app.cli reset-password <E-Mail>
# SMTP_HOST=smtp.example.de
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls (Port 587), ssl (Port 465) oder none
# SMTP_USER=
# SMTP_PASSWORD=                # oder SMTP_PASSWORD_FILE=/run/secrets/gk_smtp_password
# SMTP_FROM=Gutscheinkontor <noreply@example.de>

# Zeitzone für "heute" bei Ablaufdaten und Erinnerungen (Standard: Europe/Berlin).
# TIMEZONE=Europe/Berlin

# Erinnerungsmails vor dem Ablauf (brauchen den SMTP-Versand von oben).
# REMINDER_DAYS=30,7,1   # so viele Tage vor Ablauf, kommagetrennt
# REMINDER_HOUR=8        # Versand ab dieser Uhrzeit (0 bis 23, in der Zeitzone oben)
# REMINDERS_ENABLED=1    # 0 schaltet die Erinnerungen für alle ab

# Größe pro Anhang in MB (Standard: 10, erlaubt 1 bis 200).
# Der Reverse Proxy muss Uploads dieser Größe durchlassen, z. B. bei nginx:
#   client_max_body_size 12m;
# MAX_UPLOAD_MB=10

# Automatische Backups im Datenverzeichnis (backups/): täglich ab BACKUP_HOUR, die letzten
# BACKUP_KEEP bleiben erhalten. Sie schützen vor Bedienfehlern und Datenbankschäden, nicht vor
# dem Verlust des Datenträgers: Sichere das Volume zusätzlich außerhalb (siehe README, "Backups").
# BACKUPS_ENABLED=1
# BACKUP_HOUR=3
# BACKUP_KEEP=7

# Logo von der Webseite des Shops holen (Knopf am Gutschein, wenn eine Webshop-Adresse eingetragen ist).
# STANDARDMÄSSIG AUS: Dann ruft die App niemals fremde Server auf. Mit 1 ruft sie auf Knopfdruck die
# Webseite des Shops ab und zeigt gefundene Bilder zur Auswahl. Interne Adressen (Heimnetz, localhost)
# sind dabei gesperrt. Eigene Bilder hochladen geht immer, unabhängig von dieser Einstellung.
LOGO_FETCH=0

# Größte erlaubte Import-Datei (ZIP mit Anhängen) in MB (Standard: 200).
# Auch hier muss der Reverse Proxy Uploads dieser Größe durchlassen.
# MAX_IMPORT_MB=200

# Optional: Schützt die Ersteinrichtung, falls die Instanz schon aus dem Internet
# erreichbar ist, bevor das Admin-Konto angelegt wurde.
# SETUP_TOKEN=
